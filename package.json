{
  "name": "dlss5-manager-zjz",
  "version": "0.1.0-shell",
  "description": "装机宅 DLSS5 Manager 开源壳：游戏发现、配方安装、DLC pin/更新（MIT）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dlss5-manager-zjz": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "pins": "node dist/src/index.js pins",
    "check:updates": "node dist/src/index.js check",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "check": "npm test && node scripts/assert-no-payloads.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
